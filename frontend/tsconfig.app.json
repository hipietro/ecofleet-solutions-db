// File overview
// Purpose: Configure TypeScript checking for browser application code.
// Responsibilities: Enable DOM/Vite types, React JSX transformation and strict unused-code checks.
// Connections: Covers src files; referenced by tsconfig.json and invoked before the Vite production build.

{
  // Compiler settings for this project; comments are supported by TypeScript JSONC.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Module resolution: cooperate with Vite without writing JavaScript output. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Static checks: reject unused declarations and unsafe switch fallthrough. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Source boundary: only these files belong to this TypeScript project.
  "include": ["src"]
}
