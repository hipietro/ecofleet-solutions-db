# File overview
# Purpose: Document the local backend environment variables without storing real credentials.
# Responsibilities: Provide connection defaults and a placeholder that must be replaced by a random JWT key.
# Connections: Copy to the ignored .env file; backend/app/core/config.py loads it for the server.

# PostgreSQL section: backend/app/core/config.py reads these connection settings.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecofleet
DB_USER=postgres
DB_PASSWORD=
# JWT section: core/security signs tokens and api/dependencies validates them with this key.
# Generate a random value using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-secret
